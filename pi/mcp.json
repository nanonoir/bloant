{
    "mcpServers":  {
                       "context7":  {
                                        "url":  "https://mcp.context7.com/mcp",
                                        "enabled":  true
                                    },
                       "codegraph":  {
                                         "command":  "codegraph",
                                         "args":  [
                                                      "serve",
                                                      "--mcp"
                                                  ],
                                         "enabled":  true
                                     },
                       "playwright":  {
                                          "command":  "npx",
                                          "args":  [
                                                       "-y",
                                                       "@playwright/mcp@latest",
                                                       "--caps=devtools",
                                                       "--viewport-size=1920x1080",
                                                       "--output-dir=./recordings"
                                                   ],
                                          "enabled":  true
                                      },
                       "github":  {
                                      "url":  "https://api.githubcopilot.com/mcp/",
                                      "headers":  {
                                                      "Authorization":  "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
                                                      "X-MCP-Toolsets":  "repos,projects,issues,pull_requests,actions"
                                                  },
                                      "enabled":  true
                                  },
                       "mercadopago":  {
                                           "url":  "https://mcp.mercadopago.com/mcp",
                                           "enabled":  false
                                       }
                   }
}
