{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        {
            "action": "edit",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "subagent",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.config/opencode/**",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git reset *--hard*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git clean *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push *--force*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push * -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push * +*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push *--mirror*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push *--delete*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push -d*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push * -d*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push * :*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout *-- *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout .",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout * .",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout *--force*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout * -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout -B*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git checkout * -B*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git switch *--discard-changes*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git switch *--force*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git switch -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git switch * -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore *",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore --staged*",
            "effect": "allow"
        },
        {
            "action": "shell",
            "resource": "git restore *--worktree*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore -W*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore * -W*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore *--source*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore -s*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git restore * -s*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git branch *--force*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git branch -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git branch * -f*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git stash clear*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git stash drop*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git filter-branch*",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git filter-repo*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "read",
            "resource": "**/*.key",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/*.pem",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/.aws/credentials",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/.config/gh/hosts.yml",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/.credentials/**",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/.env",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/.env.*",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/.ssh/**",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/Library/Keychains/**",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/credentials.json",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "**/secrets/**",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.env",
            "effect": "deny"
        },
        {
            "action": "read",
            "resource": "*.env.*",
            "effect": "deny"
        }
    ],
    "agents": {
        "orchestrator": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "subagent",
                    "resource": "explorer",
                    "effect": "allow"
                },
                {
                    "action": "subagent",
                    "resource": "specs-writer",
                    "effect": "allow"
                },
                {
                    "action": "subagent",
                    "resource": "designer",
                    "effect": "allow"
                },
                {
                    "action": "subagent",
                    "resource": "implementer",
                    "effect": "allow"
                },
                {
                    "action": "subagent",
                    "resource": "reviewer",
                    "effect": "allow"
                },
                {
                    "action": "subagent",
                    "resource": "fix-agent",
                    "effect": "allow"
                },
                {
                    "action": "subagent",
                    "resource": "archiver",
                    "effect": "allow"
                }
            ]
        },
        "explorer": {
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "specs-writer": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "designer": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "implementer": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "reviewer": {
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                },
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "fix-agent": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "archiver": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "teacher": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        }
    }
}
